COMPOSE_PROJECT_NAME=autoshop
ENVIRONMENT=local

# Local defaults. Server deploy scripts override these automatically for staging/prod
# unless you pin custom absolute paths here.
AUTOSHOP_HOME=/opt/autoshop
# Optional path overrides. Leave commented to use environment-aware defaults from scripts.
# ENV_DIR=
# DATA_ROOT=
# BACKUP_ROOT=
# NGINX_CONF=
# POSTGRES_INIT_DIR=

POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
KAFKA_IMAGE=apache/kafka:3.7.1
MINIO_IMAGE=minio/minio:latest
MC_IMAGE=minio/mc:latest
NGINX_IMAGE=nginx:1.27-alpine
MAILHOG_IMAGE=mailhog/mailhog:v1.0.1

CORE_IMAGE=ghcr.io/autoshop-crm/autoshop-core
AUTH_IMAGE=ghcr.io/autoshop-crm/autoshop-auth
NOTIFICATION_IMAGE=ghcr.io/autoshop-crm/autoshop-notification
FILES_IMAGE=ghcr.io/autoshop-crm/autoshop-files
WEB_SPEC_IMAGE=ghcr.io/autoshop-crm/autoshop-web-spec
CLIENT_WEB_IMAGE=ghcr.io/autoshop-crm/autoshop-client-web

CORE_IMAGE_TAG=latest
AUTH_IMAGE_TAG=latest
NOTIFICATION_IMAGE_TAG=latest
FILES_IMAGE_TAG=latest
WEB_SPEC_IMAGE_TAG=latest
CLIENT_WEB_IMAGE_TAG=latest

POSTGRES_DEFAULT_DB=postgres
POSTGRES_USER=autoshop
POSTGRES_PASSWORD=autoshop

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

NGINX_HTTP_PORT=8088
NGINX_HTTPS_PORT=8443
POSTGRES_PUBLIC_PORT=5433
REDIS_PUBLIC_PORT=6379
KAFKA_EXTERNAL_PORT=29092
MINIO_API_PUBLIC_PORT=9000
MINIO_CONSOLE_PUBLIC_PORT=9001
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
CORE_PUBLIC_PORT=8080
AUTH_PUBLIC_PORT=8082
NOTIFICATION_PUBLIC_PORT=8083
FILES_PUBLIC_PORT=8084

BACKUP_RETENTION_DAYS=7
LOCAL_BUILD_FROM_SOURCE=true
SMOKE_RUN_FILES_CRUD=true

WEB_SPEC_PUBLIC_PORT=5173
CLIENT_WEB_PUBLIC_PORT=5174

# Local defaults for web source directories. Server deploy scripts override these
# automatically for staging/prod unless you pin custom absolute paths here.
# WEB_SPEC_SOURCE_DIR=
# CLIENT_WEB_SOURCE_DIR=
# AUTOSHOP_REPO_BASE_URL=

CLONE_MODE=clone-if-missing
SKIP_DOCKER_INSTALL=false
